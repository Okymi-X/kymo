{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Kymo Verifier definition (verifier.json)",
  "type": "object",
  "required": ["version", "checks"],
  "additionalProperties": false,
  "properties": {
    "version": { "const": 1 },
    "title": { "type": "string", "maxLength": 80 },
    "min_interval_secs": { "type": "integer", "minimum": 1, "maximum": 3600, "default": 20 },
    "run_timeout_secs": { "type": "integer", "minimum": 1, "maximum": 300 },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "ssh": {
          "type": "object",
          "required": ["user"],
          "additionalProperties": false,
          "properties": {
            "port": { "type": "integer", "minimum": 1, "maximum": 65535, "default": 22 },
            "user": { "type": "string", "minLength": 1, "maxLength": 64 },
            "key": { "type": "string", "description": "Private key path inside the definition directory." },
            "password": { "type": "string", "description": "Optional. The key is tried first when both are given." },
            "sudo": { "type": "boolean", "default": false }
          }
        }
      }
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
        "type": "object",
        "required": ["id", "title", "language", "file", "function"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9_-]{1,32}$" },
          "title": { "type": "string", "minLength": 1, "maxLength": 80, "description": "Shown to players." },
          "language": { "enum": ["bash", "python", "exec"] },
          "file": { "type": "string", "description": "A file inside the definition directory." },
          "function": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,63}$" },
          "health": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,63}$" },
          "timeout_secs": { "type": "integer", "minimum": 1, "maximum": 60, "default": 10 }
        }
      }
    },
    "messages": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "fixed": { "type": "string", "minLength": 1, "maxLength": 200 },
        "failed": { "type": "string", "minLength": 1, "maxLength": 200 },
        "broken": { "type": "string", "minLength": 1, "maxLength": 200 }
      }
    }
  }
}
