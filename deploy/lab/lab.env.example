# /etc/kymo-lab/lab.env  (mode 0640, owned by root:kymo-lab). The installer writes this file.
# Never commit the real one: the token lets whoever holds it start containers on this machine.

# Required, 24+ characters. The platform authenticates with it. Make one with: openssl rand -hex 24
KYMO_LAB_TOKEN=change-me-to-a-long-random-token

# Where the API listens. The platform connects here, so open this port to the platform only.
KYMO_LAB_ADDR=0.0.0.0:7400

# The name shown in the platform.
KYMO_LAB_NAME=lab-1

# manifest (default): only images with a file in /etc/kymo-lab/manifests run, with the port and
# limits the file sets. open: any valid image runs within the caps. Keep manifest for real events.
KYMO_LAB_MODE=manifest

# What this machine runs: docker (containers), vm (virtual machines with QEMU), or both. Unset, it
# uses what it finds installed.
#KYMO_LAB_RUNTIMES=docker,vm

# Most instances at once on this machine.
KYMO_LAB_MAX_INSTANCES=100

# Only these addresses may call the API (comma separated, CIDR ranges allowed). Set it to the
# platform's address. Empty allows any address that has the token.
#KYMO_LAB_ALLOW_FROM=203.0.113.10

# Extra host names or addresses for the generated certificate, besides the machine's own.
#KYMO_LAB_TLS_NAMES=lab.example.org,203.0.113.7

# off serves plain http (only behind a proxy that does TLS, or on a private network).
#KYMO_LAB_TLS=on
# Use a certificate you already have instead of a generated one.
#KYMO_LAB_TLS_CERT=/etc/ssl/lab.crt
#KYMO_LAB_TLS_KEY=/etc/ssl/lab.key

# VPN gateway ---------------------------------------------------------------------------------
# With this set, players reach instances through a tunnel to this machine, and no instance is
# published on any port: nothing vulnerable faces the internet. The gateway runs as a container
# (image localhost/kymo/vpn-gateway:1, built from deploy/vpn-gateway by the installer) and the
# platform drives it over this API. Open only the gateway's UDP port to players.
#KYMO_LAB_VPN_HOST=lab.example.org
#KYMO_LAB_VPN_PORT=1194
# The range lab networks are made from. The platform's KYMO_VPN_LABS must lie inside it.
#KYMO_LAB_VPN_POOL=10.77.0.0/16
# 1 (default with a gateway): refuse every instance that is not on a lab network. Set 0 only to
# let this host also publish ports for events that do not use the VPN.
#KYMO_LAB_VPN_ONLY=1
#KYMO_LAB_VPN_BIND=0.0.0.0
#KYMO_LAB_VPN_IMAGE=localhost/kymo/vpn-gateway:1

# Where instance ports are published when the VPN is not used. 0.0.0.0 makes them reachable by
# players.
#KYMO_LAB_BIND=0.0.0.0
KYMO_LAB_DATA=/var/lib/kymo-lab
KYMO_LAB_MANIFESTS=/etc/kymo-lab/manifests

# Virtual machines (runtime vm in a manifest) -------------------------------------------------
# Where the OVA and disk files are. Copy images here, then restart or run: kymo-lab prepare
#KYMO_LAB_IMAGES=/var/lib/kymo-lab/images
# Forwarded ports for machines come from this range. With the VPN they stay on this machine (the
# lab host relays them onto each player's lab network); without it, open them to players.
#KYMO_LAB_VM_PORTS=40000-40999
# auto uses KVM when /dev/kvm is usable and plain QEMU emulation otherwise (many times slower).
#KYMO_LAB_VM_ACCEL=auto
# Ceilings applied to every instance, whatever a manifest asks for.
#KYMO_LAB_MAX_MEMORY_MB=2048
#KYMO_LAB_MAX_CPUS=4
#KYMO_LAB_MAX_TTL_SECS=14400
#KYMO_LAB_QEMU=qemu-system-x86_64
#KYMO_LAB_QEMU_IMG=qemu-img
