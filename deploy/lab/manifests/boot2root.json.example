{
  "_comment": "A virtual machine with two flags, user and root, written into it over SSH when a player starts it (the HackTheBox style). Each name in flags must match a flag name of the challenge. The key is read from the lab host, never from the platform.",
  "artifact": "boot2root-box",
  "runtime": "vm",
  "file": "boot2root-box.ova",
  "ports": [
    {
      "name": "ssh",
      "port": 22
    },
    {
      "name": "web",
      "port": 80
    }
  ],
  "display": "machine",
  "memory_mb": 1024,
  "cpu_millis": 2000,
  "boot_timeout_secs": 240,
  "max_ttl_secs": 7200,
  "inject": {
    "port": 22,
    "user": "root",
    "ssh_key": "/etc/kymo-lab/keys/boot2root-box.key",
    "ssh_password": "optional, tried only if the key is refused",
    "flags": [
      {
        "name": "user",
        "path": "/home/ctf/user.txt",
        "owner": "ctf:ctf",
        "mode": "0640"
      },
      {
        "name": "root",
        "path": "/root/root.txt",
        "owner": "root:root",
        "mode": "0600"
      }
    ]
  }
}
