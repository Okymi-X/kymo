# nginx in front of Kymo. Get the certificate with certbot or any other tool.
server {
    listen 443 ssl http2;
    server_name ctf.example.org;
    ssl_certificate     /etc/letsencrypt/live/ctf.example.org/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/ctf.example.org/privkey.pem;

    client_max_body_size 256m;   # event bundles with attachments

    location / {
        proxy_pass http://127.0.0.1:8080;
        proxy_set_header Host $host;
        # Kymo reads the LAST X-Forwarded-For entry when KYMO_TRUST_PROXY=1, so append, do not replace.
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_http_version 1.1;
        proxy_buffering off;     # server sent events
        proxy_read_timeout 1h;
    }
}
