# /etc/kymo/kymo.env  (mode 0640, owned by root:kymo). Never commit the real file.

# Required. At least 12 characters. This is the organizer's password.
KYMO_ADMIN_PASSWORD=change-me-to-a-long-random-password

# Listen on loopback and put a reverse proxy with HTTPS in front (see Caddyfile.example).
KYMO_ADDR=127.0.0.1:8080
KYMO_DATABASE_URL=sqlite:///var/lib/kymo/kymo.db
# Set to 1 only when a reverse proxy sets X-Forwarded-For. Needed for correct rate limits and bans.
KYMO_TRUST_PROXY=1

# Scheduled database backups (a private directory, newest 7 kept, one every 24 hours).
KYMO_BACKUP_DIR=/var/lib/kymo/backups

# Challenge instances. Docker needs the service user in the docker group; rootless Podman needs
# DOCKER_HOST=unix:///run/user/<uid>/podman/podman.sock instead.
#KYMO_INSTANCES=docker
#KYMO_INSTANCE_HOST=ctf.example.org
#KYMO_INSTANCE_BIND=0.0.0.0

# Private VPN per player (needs KYMO_INSTANCES=docker and the gateway image, see the README).
#KYMO_VPN=1
#KYMO_VPN_HOST=vpn.example.org
#KYMO_VPN_PORT=1194
#KYMO_VPN_DIR=/var/lib/kymo/vpn
#KYMO_VPN_IMAGE=localhost/kymo/vpn-gateway:1
